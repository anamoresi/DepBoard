<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Views\Home\**" />
    <Compile Remove="Views\NovaPasta\**" />
    <Content Remove="Views\Home\**" />
    <Content Remove="Views\NovaPasta\**" />
    <EmbeddedResource Remove="Views\Home\**" />
    <EmbeddedResource Remove="Views\NovaPasta\**" />
    <None Remove="Views\Home\**" />
    <None Remove="Views\NovaPasta\**" />
  </ItemGroup>

    <ItemGroup>
	    <UpToDateCheckInput Include="Styles\input.css" />
	    <UpToDateCheckInput Include="Views\**\*.cshtml" />
	    <UpToDateCheckBuilt Include="wwwroot\css\tailwind.css" Original="Styles\input.css" />
    </ItemGroup>

  <ItemGroup>
    <Compile Remove="Controllers\HomeController.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Styles\input.css" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.31">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DepBoard.CrossCutting\DepBoard.CrossCutting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\css\" />
  </ItemGroup>

	<Target Name="InstalarNpm" BeforeTargets="GerarTailwind" Condition="!Exists('$(MSBuildProjectDirectory)\node_modules') And '$(DesignTimeBuild)' != 'true'">
		<Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)" ContinueOnError="WarnAndContinue" />
	</Target>

	<Target Name="InstalarNpm" BeforeTargets="GerarTailwind" Condition="!Exists('$(MSBuildProjectDirectory)\node_modules') And '$(DesignTimeBuild)' != 'true'">
		<Exec Command="npm install" WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>

	<Target Name="GerarTailwind" BeforeTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'">
		<Exec Command="npm run css:build" WorkingDirectory="$(MSBuildProjectDirectory)" />
	</Target>
</Project>
