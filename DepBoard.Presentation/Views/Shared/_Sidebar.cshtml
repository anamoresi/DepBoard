    {
        ("Dashboard",   "Dashboard",   "M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"),
        ("Alunos",      "Alunos",      "M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"),
        ("Disciplinas", "Disciplinas", "M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25"),
        ("Cursos",      "Cursos",      "M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342M6.75 15a.75.75 0 100-1.5.75.75 0 000 1.5zm0 0v-3.675A55.378 55.378 0 0112 8.443m-7.007 11.55A5.981 5.981 0 006.75 15.75v-1.5")
    };
}

<aside id="sidebar"
       data-collapsed="false"
       class="group sticky top-4 h-[calc(100vh-2rem)] rounded-3xl shrink-0 flex flex-col bg-french text-seashell
              w-64 data-[collapsed=true]:w-20 transition-[width] duration-300 overflow-hidden">

    <div class="flex items-center gap-3 px-4 group-data-[collapsed=true]:px-5 h-16 shrink-0">
        <button id="sidebar-toggle" type="button"
                aria-label="Abrir ou fechar menu" aria-expanded="true"
                class="grid place-items-center size-10 shrink-0 rounded-xl text-seashell
       hover:bg-seashell/15 focus:outline-none focus-visible:ring-2 focus-visible:ring-wheat cursor-pointer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" class="size-6">
                <path d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
        </button>

        <a asp-controller="Dashboard" asp-action="Index"
           class="flex items-center gap-2 min-w-0 group-data-[collapsed=true]:hidden">
            <span class="font-semibold text-lg tracking-tight truncate">AdpDepBoard</span>
        </a>
    </div>

    <hr class="mx-4 border-powder/30" />

    <nav class="flex-1 px-3 py-4">
        <ul class="flex flex-col gap-1">
            @foreach (var (controller, texto, icone) in itens)
            {
                var ativo = string.Equals(atual, controller, StringComparison.OrdinalIgnoreCase);
                <li>
                    <a asp-controller="@controller" asp-action="Index" title="@texto"
                       class="flex items-center gap-3 rounded-xl px-3 py-2.5 transition-colors
           group-data-[collapsed=true]:justify-center group-data-[collapsed=true]:px-0
           @(ativo ? "bg-seashell text-midnight" : "text-seashell/80 hover:bg-seashell/15 hover:text-seashell")">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"
                             stroke-linecap="round" stroke-linejoin="round" class="size-6 shrink-0" aria-hidden="true">
                            <path d="@icone" />
                        </svg>
                        <span class="truncate group-data-[collapsed=true]:hidden">@texto</span>
                    </a>
                </li>
            }
        </ul>
    </nav>
</aside>